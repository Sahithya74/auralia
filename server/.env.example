# Copy this file to server/.env and fill in your own values.
# Never commit server/.env - it is git-ignored.

NODE_ENV=development
PORT=4000

# MySQL connection: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# URL-encode special characters in the password (e.g. @ -> %40).
DATABASE_URL="mysql://anbu:change-me@localhost:3306/anbu"
# Separate, disposable database used ONLY by `npm test`. Its name must contain "test";
# the test suite wipes it.
TEST_DATABASE_URL="mysql://anbu:change-me@localhost:3306/anbu_test"

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=30
# BCRYPT_ROUNDS=12
# Defaults to true when NODE_ENV=production. Must be true behind HTTPS.
# COOKIE_SECURE=false

# Where the web app runs (CORS origin and links in emails).
CLIENT_ORIGIN=http://localhost:5173
APP_BASE_URL=http://localhost:5173
# Number of reverse proxies in front of the server (e.g. 1 behind Nginx/Render).
TRUST_PROXY=0

# --- AI provider ---
# anthropic or gemini: real conversations (needs that provider's key).
# mock: clearly-labelled fake replies, development only.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high - higher is slower and costs more; low suits conversation.
AI_EFFORT=low
AI_MAX_TOKENS=4096
AI_TIMEOUT_MS=60000
# Re-run a declined request on Anthropic's recommended fallback model.
AI_REFUSAL_FALLBACK=true

# Google Gemini (used when AI_PROVIDER=gemini). Key from Google AI Studio.
GEMINI_API_KEY=
# Flash-Lite answers in ~1-2 s; larger models are slower and often overloaded.
GEMINI_MODEL=gemini-3.5-flash-lite
# Backups, comma-separated, each optionally "model:thinking" (e.g. gemini-3.8-flash:low).
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest
# minimal | low | medium | high - lower is faster. "minimal" only works on Flash-Lite models.
GEMINI_THINKING_LEVEL=minimal
# If no text arrives within this many ms, a backup model is started in parallel.
GEMINI_HEDGE_MS=2500

# --- Email (password reset) ---
# console: prints reset links to this terminal in development only. smtp: real email.
MAIL_TRANSPORT=console
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Anbu <no-reply@example.com>"

# Helpline set shown with safety responses.
SAFETY_REGION=IN
LOG_LEVEL=info
